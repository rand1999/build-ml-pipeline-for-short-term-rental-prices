name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:
      input_artifact:
        description: Raw data artifact to clean (for example sample.csv:latest)
        type: string
      output_artifact:
        description: Name for the cleaned data artifact
        type: string
      output_type:
        description: Type of the cleaned data artifact
        type: string
      output_description:
        description: Description of the cleaned data artifact
        type: string
      min_price:
        description: Minimum nightly price to keep (inclusive)
        type: float
      max_price:
        description: Maximum nightly price to keep (inclusive)
        type: float

    command: >-
        python run.py --input_artifact {input_artifact} --output_artifact {output_artifact} --output_type {output_type} --output_description {output_description} --min_price {min_price} --max_price {max_price}
